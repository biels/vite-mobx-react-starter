{
  "name": "vite-mobx-react-starter",
  "description": "A modern React starter with Vite, MobX, React Router, TailwindCSS, and TypeScript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "^22.22.0 || >=24.0.0",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
